# CrossLens Release Signing Configuration
#
# This is an EXAMPLE file showing the format of keystore.properties.
# DO NOT commit the actual keystore.properties file to Git.
#
# To create your local keystore.properties file:
# 1. Copy this file to keystore.properties
# 2. Replace all placeholder values with your actual signing credentials
# 3. Ensure keystore.properties is listed in .gitignore (already configured)
#
# See docs/RELEASE_SIGNING.md for complete key generation and setup instructions.

# Path to your release keystore file (relative to project root or absolute)
# Example: keystore/crosslens-release.jks
# The keystore file itself must also be gitignored and backed up securely
storeFile=PLACEHOLDER_PATH_TO_KEYSTORE

# Keystore password (used to protect the keystore file)
storePassword=PLACEHOLDER_STORE_PASSWORD

# Key alias (identifies which key in the keystore to use)
keyAlias=PLACEHOLDER_KEY_ALIAS

# Key password (used to protect the private key)
keyPassword=PLACEHOLDER_KEY_PASSWORD

# Alternative: Environment variable configuration
# You can also set these as environment variables:
# CROSSLENS_STORE_FILE=/path/to/keystore.jks
# CROSSLENS_STORE_PASSWORD=your_store_password
# CROSSLENS_KEY_ALIAS=your_key_alias
# CROSSLENS_KEY_PASSWORD=your_key_password
#
# Environment variables take precedence over this file.
