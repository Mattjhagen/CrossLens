{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crosslens-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-24",
  "triggers": { "crons": ["17 */2 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "crosslens", "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE", "migrations_dir": "migrations" }]
}
